# ===========================================
# Environment Variables Example
# ===========================================
# Copy this file to .env and fill in real
# values before running:
#   cp .env.example .env
# ===========================================

# ===========================================
# Database (PostgreSQL)
# ===========================================
DB_NAME=game_sessions_storage
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_INTERNAL_PORT=5432
DB_EXTERNAL_PORT=5433

# ===========================================
# Backend (Spring Boot)
# ===========================================
BACKEND_INTERNAL_PORT=8080
BACKEND_EXTERNAL_PORT=8081

# ===========================================
# Frontend (React + Nginx)
# ===========================================
FRONTEND_EXTERNAL_PORT=3001
FRONTEND_INTERNAL_PORT=80

# JWT Configuration
# must be at least 32 bytes for HS256 — generate with e.g. openssl rand -base64 32
JWT_SECRET=VGhpcyBpcyBhIDEyNC1ieXRlIGJhc2U2NC1zdHJpbmcgd2hpY2ggbWF0dGVycyB0aGUgMzAtaW5zdGVhZCBtZXNzYWdlIGVuY29kZWQgaW4gSFMyNTYgKEdDVC1TZWNyZXQta2V5KQ==
